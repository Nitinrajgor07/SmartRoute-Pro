# ==============================================================================
# SmartRoute Pro — Environment Configuration Template
# ==============================================================================

# Database Credentials (PostgreSQL)
POSTGRES_DB=smartroute_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Ports
BACKEND_PORT=5000
FRONTEND_PORT=8080

# Backend Application Settings
FLASK_ENV=production
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database URL (Used by backend outside Docker or overridden by Compose)
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/smartroute_db

# Frontend Application Settings
VITE_API_BASE_URL=http://localhost:5000
VITE_MAP_PROVIDER=openstreetmap

# Authentication & JWT Configuration
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
SMARTROUTE_API_KEY=change-me

# Admin Bootstrap Credentials
ADMIN_EMAIL=admin@smartroute.pro
INITIAL_ADMIN_PASSWORD=change-me

# Database Seeding & Demo Accounts
SEED_ON_START=true
SEED_DEMO_USERS=true
DEMO_DISPATCHER_PASSWORD=change-me
DEMO_VIEWER_PASSWORD=change-me
